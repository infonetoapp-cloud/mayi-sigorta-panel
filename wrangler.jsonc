{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mayisigorta-crm",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DOCUMENTS_ENABLED": "false",
  },
  "triggers": {
    "crons": ["0 0 * * *", "*/5 * * * *"],
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "r2_buckets": [
    {
      "binding": "DOCS_QUARANTINE",
      "bucket_name": "mayisigorta-documents-quarantine",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_JOB_QUEUE",
        "queue": "mayisigorta-document-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "mayisigorta-document-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 2,
        "visibility_timeout_ms": 180000,
      },
      // D1 job state is authoritative; five-minute redispatch survives Queue expiry/exhaustion.
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayisigorta-crm-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations",
    },
  ],
  "env": {
    // Read-proven foundation only. No Worker deployment or remote migrations yet.
    "foundation": {
      "name": "mayisigorta-crm-foundation",
      "account_id": "af9fc98cb8d5f5508d58057bc794d863",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "DOCUMENTS_ENABLED": "false",
      },
      "triggers": {
        "crons": [],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mayisigorta-crm",
          "database_id": "1dd3b04e-14b8-459c-86d0-5c3c3ed8127d",
          "migrations_dir": "db/migrations",
        },
      ],
      // R2 checkout/usage-billing approval and private EU readback are pending.
      "r2_buckets": [],
      "queues": {
        "producers": [
          {
            "binding": "DOCUMENT_JOB_QUEUE",
            "queue": "mayisigorta-document-jobs",
          },
        ],
        "consumers": [],
      },
    },
  },
}
