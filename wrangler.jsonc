{
  "$schema": "node_modules/wrangler/config-schema.json",
  "durable_objects": {
    "bindings": [{ "name": "PASSWORD_KDF", "class_name": "PasswordKdfDurableObject" }],
  },
  "migrations": [{ "tag": "password-kdf-v2", "new_sqlite_classes": ["PasswordKdfDurableObject"] }],
  "name": "mayisigorta-crm",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "AUTH_ACCOUNT_RATE_LIMITER",
      "namespace_id": "2701",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AUTH_SOURCE_RATE_LIMITER",
      "namespace_id": "2702",
      "simple": { "limit": 1000, "period": 60 },
    },
  ],
  "vars": {
    "DOCUMENTS_ENABLED": "false",
  },
  "triggers": {
    "crons": ["0 0 * * *", "*/5 * * * *"],
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "r2_buckets": [
    {
      "binding": "DOCS_QUARANTINE",
      "bucket_name": "mayisigorta-documents-quarantine",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_JOB_QUEUE",
        "queue": "mayisigorta-document-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "mayisigorta-document-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 2,
        "visibility_timeout_ms": 180000,
      },
      // D1 job state is authoritative; five-minute redispatch survives Queue expiry/exhaustion.
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayisigorta-crm-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations",
    },
  ],
  "env": {
    // Preserve only the accepted panel custom domain; local configuration is not deployment authority.
    "production": {
      "name": "mayisigorta-crm",
      "account_id": "af9fc98cb8d5f5508d58057bc794d863",
      "compatibility_date": "2026-09-01",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "panel.mayisigorta.com", "custom_domain": true }],
      "vars": {
        "APP_ENV": "production",
        "PANEL_ORIGIN": "https://panel.mayisigorta.com",
        "DOCUMENTS_ENABLED": "false",
        "DOCUMENT_JOBS_ENABLED": "true",
        "DOCUMENT_CRON_ENABLED": "true",
      },
      "services": [
        {
          "binding": "DOCUMENT_BACKUP_CAPABILITY",
          "service": "mayisigorta-document-backup",
          "entrypoint": "DocumentBackupCapability",
        },
      ],
      // Names only. Required-secret metadata is not provisioning or a live existence assertion.
      "secrets": { "required": ["CSRF_SECRET", "TURNSTILE_SITE_KEY", "TURNSTILE_SECRET"] },
      // Invocation metrics only; never add body/password/verifier/header logging.
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
        "traces": { "enabled": false },
      },
      "durable_objects": {
        "bindings": [
          { "name": "PASSWORD_KDF", "class_name": "PasswordKdfDurableObject" },
          { "name": "DOCUMENT_UPLOAD_RUNTIME", "class_name": "DocumentUploadDurableObject" },
        ],
      },
      "migrations": [
        { "tag": "password-kdf-v2", "new_sqlite_classes": ["PasswordKdfDurableObject"] },
        { "tag": "document-upload-v1", "new_sqlite_classes": ["DocumentUploadDurableObject"] },
      ],
      "ratelimits": [
        {
          "name": "AUTH_ACCOUNT_RATE_LIMITER",
          "namespace_id": "2701",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "AUTH_SOURCE_RATE_LIMITER",
          "namespace_id": "2702",
          "simple": { "limit": 1000, "period": 60 },
        },
        {
          "name": "DOCUMENT_UPLOAD_RATE_LIMITER",
          "namespace_id": "2703",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "DOCUMENT_DOWNLOAD_RATE_LIMITER",
          "namespace_id": "2704",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
        "run_worker_first": true,
        "html_handling": "none",
        "not_found_handling": "none",
      },
      "triggers": { "crons": ["0 0 * * *", "*/5 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mayisigorta-crm",
          "database_id": "1dd3b04e-14b8-459c-86d0-5c3c3ed8127d",
          "migrations_dir": "db/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DOCS_QUARANTINE",
          "bucket_name": "mayisigorta-documents-quarantine",
          "jurisdiction": "eu",
        },
        {
          "binding": "DOCUMENT_QUEUE_CUSTODY",
          "bucket_name": "mayisigorta-document-queue-custody",
          "jurisdiction": "eu",
        },
      ],
      "queues": {
        "producers": [{ "binding": "DOCUMENT_JOB_QUEUE", "queue": "mayisigorta-document-jobs-v2" }],
        "consumers": [
          {
            "queue": "mayisigorta-document-jobs-v2",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 5,
            "dead_letter_queue": "mayisigorta-document-jobs-v2-dlq",
          },
        ],
      },
    },
    // Read-proven foundation only. No Worker deployment or remote migrations yet.
    "foundation": {
      "name": "mayisigorta-crm-foundation",
      "durable_objects": {
        "bindings": [{ "name": "PASSWORD_KDF", "class_name": "PasswordKdfDurableObject" }],
      },
      "account_id": "af9fc98cb8d5f5508d58057bc794d863",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        // PASSWORD_KDF is explicit for this environment because bindings do not inherit.
        "DOCUMENTS_ENABLED": "false",
      },
      "triggers": {
        "crons": [],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mayisigorta-crm",
          "database_id": "1dd3b04e-14b8-459c-86d0-5c3c3ed8127d",
          "migrations_dir": "db/migrations",
        },
      ],
      // Private Standard EU bucket verified by control-plane readback; no public access.
      "r2_buckets": [
        {
          "binding": "DOCS_QUARANTINE",
          "bucket_name": "mayisigorta-documents-quarantine",
          "jurisdiction": "eu",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "DOCUMENT_JOB_QUEUE",
            "queue": "mayisigorta-document-jobs",
          },
        ],
        "consumers": [],
      },
    },
  },
}
