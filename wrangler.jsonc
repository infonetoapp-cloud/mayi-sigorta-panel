{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mayisigorta-crm",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DOCUMENTS_ENABLED": "false",
  },
  "triggers": {
    "crons": ["0 0 * * *", "*/5 * * * *"],
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "r2_buckets": [
    {
      "binding": "DOCS_QUARANTINE",
      "bucket_name": "mayisigorta-documents-quarantine",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "DOCUMENT_SCAN_QUEUE",
        "queue": "mayisigorta-document-scan",
      },
    ],
    "consumers": [
      {
        "queue": "mayisigorta-document-scan",
        "dead_letter_queue": "mayisigorta-document-scan-dead-letter",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 2,
        "visibility_timeout_ms": 180000,
      },
      {
        "queue": "mayisigorta-document-scan-dead-letter",
        "dead_letter_queue": "mayisigorta-document-scan-dead-letter-overflow",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1,
        "visibility_timeout_ms": 180000,
      },
      {
        "queue": "mayisigorta-document-scan-dead-letter-overflow",
        "dead_letter_queue": "mayisigorta-document-scan-dead-letter-terminal",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 5,
        "max_concurrency": 1,
        "visibility_timeout_ms": 180000,
      },
      {
        "queue": "mayisigorta-document-scan-dead-letter-terminal",
        "dead_letter_queue": "mayisigorta-document-scan-dead-letter-hold",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "max_concurrency": 1,
        "visibility_timeout_ms": 180000,
      },
      // Final hold has no consumer; current default is 4 days. Provision 14 days and monitoring/replay per the M4 runbook before enabling documents.
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mayisigorta-crm-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "db/migrations",
    },
  ],
}
